#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200
#define ZMK_POINTING_DEFAULT_SCRL_VAL 20

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

/ {
    behaviors {
        caps_fn: caps_fn {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <600>;
            flavor = "tap-preferred";
        };

        homerow: homerow {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "tap-preferred";
            quick-tap-ms = <300>;
        };

        space_period: space_period {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
        };

        thumb: thumb {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            flavor = "balanced";
            quick-tap-ms = <150>;
        };

        sft: sft {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&kp>, <&sk>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
        };

        long_bt_clr: long_bt_clr {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&macro_bt_clr>, <&none>;

            #binding-cells = <2>;
            tapping-term-ms = <1000>;
        };

        tog_conf: tog_conf {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&tog>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };

        tog_conf2: tog_conf2 {
            compatible = "zmk,behavior-hold-tap";
            bindings = <&tog>, <&macro_rgb_tog>;

            #binding-cells = <2>;
            tapping-term-ms = <500>;
        };
    };

    combos {
        compatible = "zmk,combos";

        cut_M {
            bindings = <&kp LG(X)>;
            key-positions = <25 26>;
            timeout-ms = <100>;
            layers = <1>;
        };

        copy_M {
            bindings = <&kp LG(C)>;
            key-positions = <26 27>;
            layers = <1>;
            timeout-ms = <100>;
        };

        paste_M {
            bindings = <&kp LG(V)>;
            key-positions = <27 28>;
            timeout-ms = <100>;
            layers = <1>;
        };

        cut_W {
            bindings = <&kp LC(X)>;
            key-positions = <25 26>;
            timeout-ms = <100>;
            layers = <0>;
        };

        copy_W {
            bindings = <&kp LC(C)>;
            key-positions = <26 27>;
            layers = <0>;
            timeout-ms = <100>;
        };

        paste_W {
            bindings = <&kp LC(V)>;
            key-positions = <27 28>;
            timeout-ms = <100>;
            layers = <0>;
        };
    };

    macros {
        macro_bt_clr: macro_bt_clr {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&bt BT_CLR>;
        };

        /* Cornix uses its stock indicator implementation, not Corne underglow. */
        macro_rgb_tog: macro_rgb_tog {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&none>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        windows_layer {
            display-name = "Windows";
            bindings = <
&kp ESCAPE                    &kp Q                &kp W                &kp E                    &kp R                  &kp T                       &kp Y           &kp U                  &kp I                    &kp O                &kp P                        &kp BSPC
&caps_fn CAPSLOCK LANGUAGE_1  &homerow LEFT_GUI A  &homerow LEFT_ALT S  &homerow LEFT_CONTROL D  &homerow LEFT_SHIFT F  &kp G                       &kp H           &homerow LEFT_SHIFT J  &homerow LEFT_CONTROL K  &homerow LEFT_ALT L  &homerow LEFT_GUI SEMICOLON  &kp SQT
&kp LSHIFT                    &kp Z                &kp X                &kp C                    &kp V                  &kp B  &tog_conf 8 C_MUTE  &none  &kp N           &kp M                  &kp COMMA                &kp DOT              &kp FSLH                     &kp LSHIFT
&none                         &none                &none                &thumb 4 ESCAPE          &thumb 5 SPACE          &thumb 6 TAB                 &thumb 5 ENTER   &thumb 6 SPACE         &thumb 4 DELETE           &none                &none                        &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        macos_layer {
            display-name = "macOS";
            bindings = <
&kp ESCAPE                    &kp Q                    &kp W                &kp E                &kp R                  &kp T                       &kp Y           &kp U                   &kp I                 &kp O                 &kp P                             &kp BSPC
&caps_fn CAPSLOCK LANGUAGE_1  &homerow LEFT_CONTROL A  &homerow LEFT_ALT S  &homerow LEFT_GUI D  &homerow LEFT_SHIFT F  &kp G                       &kp H           &homerow RIGHT_SHIFT J  &homerow RIGHT_GUI K  &homerow RIGHT_ALT L  &homerow RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHIFT                    &kp Z                    &kp X                &kp C                &kp V                  &kp B  &tog_conf 8 C_MUTE  &none  &kp N           &kp M                   &kp COMMA             &kp DOT               &kp FSLH                          &kp LSHIFT
&none                         &none                    &none                &thumb 7 ESCAPE      &thumb 5 SPACE          &thumb 6 TAB                 &thumb 5 ENTER   &thumb 6 SPACE          &thumb 7 DEL          &none                 &none                              &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        gaming_layer {
            display-name = "Game";
            bindings = <
&kp ESCAPE  &kp Q      &kp W      &kp E      &kp R      &kp T                   &kp Y           &kp U           &kp I            &kp O    &kp P          &kp BSPC
&kp TAB     &kp A      &kp S      &kp D      &kp F      &kp G                   &kp H           &kp J           &kp K            &kp L    &kp SEMICOLON  &kp SQT
&kp LSHIFT  &kp Z      &kp X      &kp C      &kp V      &kp B  &kp C_MUTE  &none  &kp N           &kp M           &kp COMMA        &kp DOT  &kp FSLH       &kp LSHIFT
&kp LCTRL   &kp LGUI   &kp LALT   &kp LCTRL  &kp SPACE  &kp LALT                &thumb 5 ENTER  &thumb 6 SPACE  &thumb 4 DELETE  &none   &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        gaming_layer2 {
            display-name = "Game+Arr";
            bindings = <
&kp ESCAPE  &kp Q      &kp W      &kp E      &kp R      &kp T                   &kp Y           &kp U           &kp UP           &kp O      &kp P          &kp BSPC
&kp TAB     &kp A      &kp S      &kp D      &kp F      &kp G                   &kp H           &kp LEFT        &kp DOWN         &kp RIGHT  &kp SEMICOLON  &kp SQT
&kp LSHIFT  &kp Z      &kp X      &kp C      &kp V      &kp B  &kp C_MUTE  &none  &kp N           &kp M           &kp COMMA        &kp DOT    &kp FSLH       &kp LSHIFT
&kp LCTRL   &kp LGUI   &kp LALT   &kp LCTRL  &kp SPACE  &kp LALT                &thumb 5 ENTER  &thumb 6 SPACE  &thumb 4 DELETE  &none     &none           &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };

        fn_ms_layer {
            display-name = "Fn+Mouse";
            bindings = <
&trans  &kp F10                &kp F7                &kp F8                    &kp F9                  &trans                    &mkp MB5        &msc SCRL_UP    &mmv MOVE_UP    &trans           &trans           &trans
&trans  &homerow LEFT_GUI F11  &homerow LEFT_ALT F4  &homerow LEFT_CONTROL F5  &homerow LEFT_SHIFT F6  &trans                    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &trans
&trans  &kp F12                &kp F1                &kp F2                    &kp F3                  &trans  &kp C_PP  &none  &mkp MB4        &msc SCRL_DOWN  &kp C_PREV      &kp C_NEXT       &kp C_PP         &trans
&none   &none                  &none                  &trans                    &trans                  &trans                    &mkp MB1        &mkp MB2        &mkp MB3        &none            &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC &inc_dec_kp PG_UP PG_DN>;
        };

        arrow_layer {
            display-name = "Arrow";
            bindings = <
&trans  &trans  &trans  &trans  &trans    &trans                    &kp PG_UP  &kp PG_UP  &kp UP    &trans     &trans   &trans
&trans  &trans  &trans  &trans  &trans    &trans                    &kp HOME   &kp LEFT   &kp DOWN  &kp RIGHT  &kp END  &trans
&trans  &trans  &trans  &trans  &trans    &trans  &kp C_PP  &none  &kp PG_DN  &kp PG_DN  &trans    &trans     &trans   &trans
&none   &none   &none   &trans  &trans    &trans                    &trans     &trans     &trans    &none      &none    &none
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp PG_UP PG_DN>;
        };

        num_layer {
            display-name = "Number";
            bindings = <
&kp GRAVE  &kp LBKT  &kp N7  &kp N8                  &kp N9                   &kp N0                       &trans     &trans     &trans  &trans  &trans  &trans
&trans     &kp RBKT  &kp N4  &kp N5                  &kp N6                   &kp MINUS                    &trans     &kp ENTER  &trans  &trans  &trans  &trans
&trans     &kp BSLH  &kp N1  &kp N2                  &kp N3                   &kp EQUAL  &kp C_PP  &none  &trans     &trans     &trans  &trans  &trans  &trans
&none      &none     &none   &kp N0  &space_period DOT SPACE  &trans                       &trans     &trans     &trans  &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_NEXT C_PREV &inc_dec_kp PG_UP PG_DN>;
        };

        fn_ms_mac_layer {
            display-name = "Fn+Mouse";
            bindings = <
&trans  &kp F10                    &kp F7                &kp F8                &kp F9                  &trans                    &mkp MB5        &msc SCRL_UP    &mmv MOVE_UP    &trans           &trans           &trans
&trans  &homerow LEFT_CONTROL F11  &homerow LEFT_ALT F4  &homerow LEFT_GUI F5  &homerow LEFT_SHIFT F6  &trans                    &msc SCRL_LEFT  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_RIGHT  &msc SCRL_RIGHT  &trans
&trans  &kp F12                    &kp F1                &kp F2                &kp F3                  &trans  &kp C_PP  &none  &mkp MB4        &msc SCRL_DOWN  &kp C_PREV      &kp C_NEXT       &kp C_PP         &trans
&none   &none                      &none                  &trans                &trans                  &trans                    &mkp MB1        &mkp MB2        &mkp MB3        &none            &none            &none
            >;

            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC &inc_dec_kp PG_UP PG_DN>;
        };

        conf_layer {
            display-name = "Config";
            bindings = <
&long_bt_clr 0 0  &trans  &trans        &trans        &trans        &bootloader                  &bootloader  &trans  &trans  &trans  &trans  &studio_unlock
&trans            &trans  &bt BT_SEL 3  &bt BT_SEL 4  &out OUT_TOG  &trans                       &trans  &to 0   &to 1   &to 2   &to 3   &trans
&none             &trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &trans  &tog_conf2 8 0  &none  &trans  &trans  &trans  &trans  &trans  &trans
&none             &none   &none         &trans        &trans        &trans                       &trans  &trans  &trans  &none   &none   &none
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOLUME_DOWN &inc_dec_kp PG_UP PG_DN>;
        };
    };
};
